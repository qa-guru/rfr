{
  "permissions": {
    "allow": [
      "Shell(gradlew)",
      "Shell(gradlew.bat)",
      "Shell(./gradlew)",
      "Shell(npm:run dev*)",
      "Shell(npm:run preview*)",
      "Shell(docker:compose up -d mysql*)",
      "Shell(docker:compose start mysql*)",
      "Shell(docker:compose stop mysql*)",
      "Shell(bash:localenv.sh*)",
      "Shell(mv)",
      "Mcp(cursor-ide-browser:*)",
      "Mcp(playwright:*)",
      "Write(**/*.bak)"
    ],
    "deny": [
      "Shell(git:*push*)",
      "Shell(git:rm*)",
      "Shell(rm)",
      "Shell(unlink)",
      "Shell(find)",
      "Shell(del)",
      "Shell(erase)",
      "Shell(rmdir)",
      "Shell(rd)",
      "Shell(Remove-Item)",
      "Shell(ri)",
      "Shell(shred)"
    ]
  }
}
